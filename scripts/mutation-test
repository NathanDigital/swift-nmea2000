#!/usr/bin/env python3
"""Mutation-test the Swift sources: check that the test suite catches small bugs.

Each mutant makes one small, realistic change to a source file (a wrong
resolution, mask, shift, flag bit or signedness; a wrong reserved or NA value;
an off-by-one capacity check; a dropped field), runs the full test suite in
the pinned container, and restores the file. A mutant the tests catch is
"killed". One they don't catch has "survived", which points to a missing test
input or assertion, unless the change can't alter behaviour.

    scripts/mutation-test                       # PGN types and the field codec
    scripts/mutation-test Sources/NMEA2000/PGNs/PGN129029*.swift
    scripts/mutation-test --list                # show the mutants, run nothing
    scripts/mutation-test --only 3,17           # rerun particular mutants
    scripts/mutation-test --since HEAD~1 <files> # only lines changed since a commit

The target files are edited in place and restored after each mutant, including
on Ctrl-C. The script refuses to run if any target file has uncommitted
changes. Each mutant takes a few seconds, so a full run takes a while.
Exits with status 1 if any mutant survives.
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_TARGETS = [
    "Sources/NMEA2000/PGNs/*.swift",
    "Sources/NMEA2000/Message/MessageWriter.swift",
    "Sources/NMEA2000/Message/MessageReader.swift",
    "Sources/NMEA2000/Message/ParameterGroup.swift",
]

MASKS = {"1f": "0f", "0f": "07", "07": "03", "7": "3", "03": "01", "01": "03"}
BOUNDARIES = {"<": "<=", "<=": "<", ">": ">=", ">=": ">"}
FLAGS = {"40": "20", "10": "08", "04": "02", "e0": "f0", "c0": "80", "f0": "e0", "fc": "f8"}


def flip_sign(m):
    return ("" if m.group(1) else "U") + "Int" + m.group(2)


# (name, pattern, replacement). Patterns match within one source line.
OPERATORS = [
    ("resolution", r"resolution: ([0-9.e+-]+)", lambda m: f"resolution: {m.group(1)} * 10"),
    ("mask", r"& 0x(1f|0f|07|7|03|01)\b", lambda m: "& 0x" + MASKS[m.group(1)]),
    ("shift", r"(<<|>>) (\d+)\b", lambda m: f"{m.group(1)} {int(m.group(2)) + 1}"),
    ("flag-bit", r"0x(40|10|04|e0|c0|f0|fc)\b", lambda m: "0x" + FLAGS[m.group(1)]),
    ("reserved", r"appendUInt8\(0xff\)", lambda m: "appendUInt8(0xfe)"),
    ("reserved", r"appendUInt16\(0xffff\)", lambda m: "appendUInt16(0xfffe)"),
    (
        "signedness",
        r"append(U?)Int(8|16|32)\((?=[\w.]+, resolution)",
        lambda m: "append" + flip_sign(m) + "(",
    ),
    # Call sites only: mutating a declaration just makes a duplicate function.
    ("signedness", r"(?<!func )read(U?)Int(8|16|32)\((?=resolution)", lambda m: "read" + flip_sign(m) + "("),
    ("condition", r" != 0\b", lambda m: " == 0"),
    ("condition", r"\? 0x(\w+) : 0\)", lambda m: f"? 0 : 0x{m.group(1)})"),
    ("limit", r"(static let \w+(?:Count|Length) = )(\d+)", lambda m: f"{m.group(1)}{int(m.group(2)) - 1}"),
    ("capacity", r" < Message\.maxDataCount", lambda m: " <= Message.maxDataCount"),
    # Comparisons with spaces on both sides, so generic brackets don't match.
    ("boundary", r"(?<=[\w)\]]) (<=|>=|<|>) (?=[\w(.])", lambda m: f" {BOUNDARIES[m.group(1)]} "),
    ("arithmetic", r"(?<=[\w)\]]) ([+-]|&\+|&-) (\d+)\b", lambda m: f" {m.group(1)} {int(m.group(2)) + 1}"),
    ("not-available", r"\?\? 0x(\w+)", lambda m: "?? 0x00"),
    (
        "drop-field",
        r"^(\s+)(writer\.append\w+\(.*\)|_ = reader\.read\w+\(\)|reader\.skip\(\d+\))$",
        lambda m: f"{m.group(1)}// mutant: removed",
    ),
]


def changed_lines(path, since):
    """The line numbers of a file that differ from commit `since`."""
    diff = subprocess.run(
        ["git", "diff", "--unified=0", since, "--", path],
        cwd=REPO, capture_output=True, text=True, check=True,
    ).stdout
    lines = set()
    for m in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, flags=re.M):
        start, count = int(m.group(1)), int(m.group(2) or 1)
        lines.update(range(start, start + count))
    return lines


def find_mutants(paths):
    mutants = []
    for path in paths:
        source = open(path, encoding="utf-8").read()
        for name, pattern, replace in OPERATORS:
            for m in re.finditer(pattern, source, flags=re.M):
                line_start = source.rfind("\n", 0, m.start()) + 1
                if source[line_start : m.start()].lstrip().startswith("//"):
                    continue  # Inside a comment.
                mutants.append(
                    {
                        "file": os.path.relpath(path, REPO),
                        "line": source.count("\n", 0, m.start()) + 1,
                        "operator": name,
                        "old": m.group(0).strip(),
                        "new": replace(m).strip(),
                        "start": m.start(),
                        "end": m.end(),
                        "replacement": replace(m),
                    }
                )
    for number, mutant in enumerate(mutants):
        mutant["id"] = number
    return mutants


# A mutant can leave an async test waiting forever. Test time limits catch
# most of those; this catches the rest.
TEST_TIMEOUT = 600

# The tests run in one long-lived container, which saves starting one per
# mutant (see scripts/linux-swift).
SESSION = f"nmea2000-mutation-{os.getpid()}"
LINUX_SWIFT = os.path.join(REPO, "scripts", "linux-swift")


def start_session():
    subprocess.run([LINUX_SWIFT, "--start-session", SESSION], check=True)
    os.environ["LINUX_SWIFT_SESSION"] = SESSION


def stop_session():
    subprocess.run([LINUX_SWIFT, "--stop-session", SESSION], capture_output=True)


def run_tests():
    process = subprocess.Popen(
        [os.path.join(REPO, "scripts", "linux-swift"), "test"],
        cwd=REPO,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        errors="replace",  # A mutant can make a test print bytes that aren't UTF-8.
    )
    try:
        output, _ = process.communicate(timeout=TEST_TIMEOUT)
    except subprocess.TimeoutExpired:
        # docker exec doesn't pass signals on, so the hung tests keep running in
        # the container: replace it.
        process.terminate()
        output, _ = process.communicate()
        stop_session()
        start_session()
        return "killed", output  # The mutant hung the tests.
    result = process
    if re.search(r"\.swift:\d+:\d+: error:", output) or (
        "error: Build failed" in output and "Test run started" not in output
    ):
        return "invalid", output  # The mutant doesn't compile.
    if "✘" in output or "exited with unexpected signal" in output:
        return "killed", output  # A test failed, or the mutant crashed the tests.
    if result.returncode != 0:
        # Neither a compile error nor a test failure, e.g. Docker failed. Don't
        # count it as killed, or a broken environment would look like success.
        sys.exit("error: the test run failed without a test failure:\n" + output[-2000:])
    return "survived", output


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("files", nargs="*", help="source files to mutate (default: PGNs and codec)")
    parser.add_argument("--list", action="store_true", help="list the mutants without running them")
    parser.add_argument("--only", help="comma-separated mutant ids to run")
    parser.add_argument("--output", help="also write one JSON result per line to this file")
    parser.add_argument(
        "--since", metavar="COMMIT", help="only mutate lines changed since this commit"
    )
    args = parser.parse_args()

    patterns = args.files or [os.path.join(REPO, p) for p in DEFAULT_TARGETS]
    paths = sorted({os.path.abspath(p) for pattern in patterns for p in glob.glob(pattern)})
    if not paths:
        sys.exit("error: no source files match")
    mutants = find_mutants(paths)
    if args.only:
        wanted = {int(x) for x in args.only.split(",")}
        mutants = [m for m in mutants if m["id"] in wanted]
    if args.since:
        changed = {path: changed_lines(path, args.since) for path in paths}
        mutants = [m for m in mutants if m["line"] in changed[os.path.join(REPO, m["file"])]]

    if args.list:
        for m in mutants:
            print(f"{m['id']:4} {m['file']}:{m['line']} {m['operator']}: {m['old']} -> {m['new']}")
        print(f"{len(mutants)} mutants")
        return 0

    dirty = subprocess.run(
        ["git", "status", "--porcelain", "--", *paths], cwd=REPO, capture_output=True, text=True
    ).stdout
    if dirty.strip():
        sys.exit("error: commit or stash changes to the target files first:\n" + dirty)

    start_session()
    try:
        return run_mutants(mutants, args.output)
    finally:
        stop_session()


def run_mutants(mutants, output_path):
    print("Running the unmutated test suite...", flush=True)
    status, output = run_tests()
    if status != "survived":
        sys.exit("error: the test suite must pass before mutation testing:\n" + output[-2000:])

    log = open(output_path, "w") if output_path else None
    counts = {"killed": 0, "survived": 0, "invalid": 0}
    survivors = []
    for index, m in enumerate(mutants, 1):
        path = os.path.join(REPO, m["file"])
        original = open(path, encoding="utf-8").read()
        started = time.time()
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(original[: m["start"]] + m["replacement"] + original[m["end"] :])
            status, _ = run_tests()
        finally:
            with open(path, "w", encoding="utf-8") as f:
                f.write(original)
        counts[status] += 1
        if status == "survived":
            survivors.append(m)
        print(
            f"[{index}/{len(mutants)}] {status:8} {m['file']}:{m['line']} "
            f"{m['operator']}: {m['old']} -> {m['new']} ({time.time() - started:.0f}s)",
            flush=True,
        )
        if log:
            record = {k: m[k] for k in ("id", "file", "line", "operator", "old", "new")}
            log.write(json.dumps({**record, "status": status}) + "\n")
            log.flush()

    print(
        f"\n{counts['killed']} killed, {counts['survived']} survived, "
        f"{counts['invalid']} didn't compile"
    )
    for m in survivors:
        print(f"  survived {m['id']}: {m['file']}:{m['line']} {m['operator']}: {m['old']} -> {m['new']}")
    return 1 if survivors else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit("\ninterrupted; the file being mutated was restored")
